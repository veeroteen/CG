<Window x:Class="CG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CG" xmlns:sharpgl="clr-namespace:SharpGL.WPF;assembly=SharpGL.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="DimGray">

        <sharpgl:OpenGLControl
            x:Name="openGLControl" 
            Focusable="True" 
            Margin="5,0,5,5"
            DrawFPS="True"
            OpenGLInitialized="OpenGLControl_OpenGLInitialized" 
            OpenGLDraw="OpenGLControl_OpenGLDraw"
            MouseDown="openGLControl_MouseDown"
            MouseUp="openGLControl_MouseUp"
            MouseWheel="openGLControl_MouseWheel"
            Keyboard.KeyDown="openGLControl_KeyDown"
            Keyboard.KeyUp="openGLControl_KeyUp"
            SizeChanged="openGLControl_SizeChanged"
            >
            <sharpgl:OpenGLControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Сменить режим">
                        <MenuItem Header="DRAW"
                        Click="ChangeModeDraw"/>

                        <MenuItem Header="SELECTION"
                        Click="ChangeModeSelect"/>

                        <MenuItem Header="MOVE"
                        Click="ChangeModeMove"/>
                    </MenuItem>
                    <MenuItem Header="Удалить текущую группу" Click="DeleteGroup_Click"/>
                    
                    <MenuItem Header="Модифицировать текущую группу"
                      Click="ChangeGroup_Click"/>
                </ContextMenu>
            </sharpgl:OpenGLControl.ContextMenu>
        </sharpgl:OpenGLControl>
            
        <ComboBox
            x:Name="InputModeComboBox"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="10,10,0,0"
            Width="105"
            SelectionChanged="InputModeComboBox_SelectionChanged" Background="#E61F1F1F" BorderBrush="#FF4A4A4A"
        />
        <Button Content="&lt;" Height="25" Width="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,79,0" Focusable="False" Click="PrevGroup_Click"/>
        <Button x:Name="CurrGroup" Content="2222" Height="25" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,39,0" Focusable="False" Click="CurrGroup_Click"/>
        <Button Content="&gt;" Height="25" Width="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,19,0" Focusable="False" Click="NextGroup_Click"/>
        
    </Grid>
</Window>
